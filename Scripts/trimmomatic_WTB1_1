#!/bin/bash
#SBATCH --job-name=trimmomatic_2 --output=z01.%x
#SBATCH --mail-type=END,FAIL --mail-user=hjr47@georgetown.edu
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=1  --time=72:00:00
#SBATCH --mem=4G

#------------------set enviornment, load module-------------#
shopt -s expand_aliases
module load trimmomatic

#------------------define variable with file locations------#
adapters=/home/hjr47/HW4_input_files/TruSeq3-PE.fa

input_R1=/home/hjr47/RNAseq_files/WTB1_1.fq.gz
input_R2=/home/hjr47/RNAseq_files/WTB1_2.fq.gz

output_R1_PE=/home/hjr47/RNAseq_files/WTB1_1_trmPE.fq.gz
output_R1_SE=/home/hjr47/RNAseq_files/WTB1_1_trmSE.fq.gz

output_R2_PE=/home/hjr47/RNAseq_files/WTB1_2_trmPE.fq.gz
output_R2_SE=/home/hjr47/RNAseq_files/WTB1_2_trmSE.fq.gz

#----------------run trimmomatic---------------------------#
trimmomatic PE \
$input_R1 \
$input_R2 \
$output_R1_PE $output_R1_SE \
$output_R2_PE $output_R2_SE \
SLIDINGWINDOW:4:15 \
HEADCROP:17 \
TRAILING:15 \
ILLUMINACLIP:$adapters:2:30:10 \
MINLEN:75

module unload trimmomatic
#----------------------------------------------------------#
